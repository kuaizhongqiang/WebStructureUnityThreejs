#!/bin/sh
# 提交前门禁（docs/DECISIONS.md DEC-66）。
# 本体不入库：本文件是安装源，由 tools/install-hooks.ps1 复制到 .git/hooks/pre-commit。
# 改本文件后必须重新运行安装脚本，否则不会生效。

set -e

root=$(git rev-parse --show-toplevel)
cd "$root"

echo "[gate] 1/4 大文件与忽略规则"
node tools/check-large-files.mjs

echo "[gate] 2/4 业务代码零 import electron（DEC-20）"
node tools/check-shell-coupling.mjs

echo "[gate] 3/4 双端契约一致性（TS <-> 快照 <-> C#）"
node tools/check-contracts.mjs

echo "[gate] 4/4 Web 侧类型检查与单测"
if [ -d web/node_modules ]; then
  cd web
  npm run typecheck
  npm test
else
  echo "[gate] 跳过：web/node_modules 不存在（先在该目录执行 npm install）"
fi

echo "[gate] 全部通过。"
