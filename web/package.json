{
  "name": "wsu3-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "WebStructureUnityThreejs - Web side (Vue 3 + Three.js shell). Decisions: docs/DECISIONS.md DEC-15.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "node tools/render-smoke.mjs",
    "verify:unity": "node tools/verify-unity-transparency.mjs",
    "icon": "node tools/make-app-icon.mjs"
  },
  "dependencies": {
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.0.3",
    "three": "^0.186.1",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.13"
  }
}
